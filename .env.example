# App
DEBUG=false
SECRET_KEY=change-this-in-production-super-secret-key

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/hinglish_dub
REDIS_URL=redis://redis:6379/0

# AI APIs (at least one required)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ELEVENLABS_API_KEY=...

# HuggingFace (for diarization)
HF_TOKEN=hf_...

# Google Cloud (fallback TTS)66
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Storage
S3_BUCKET=hinglish-dub-storage
S3_REGION=us-east-1
LOCAL_STORAGE_PATH=/tmp/hinglish-dub

# Processing
WHISPER_MODEL=large-v3
MAX_WORKERS=4
CHUNK_DURATION=10

# Live Stream
LIVE_BUFFER_SECONDS=3
LIVE_RECONNECT_ATTEMPTS=5
